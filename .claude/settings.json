{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); if [ -n \"$f\" ] && [ -f \"$f\" ]; then npx biome check --write --skip=correctness/noUnusedImports \"$f\"; fi"
          },
          {
            "type": "command",
            "command": "out=$(node scripts/check-design-tokens.mjs 2>&1) || { printf '%s\\n' \"$out\" >&2; echo '^ DESIGN-TOKEN VIOLATION (design.md is the authority): tokenize the value(s) above per design.md. No hardcoded colors, no text-[Npx]. Fix before continuing.' >&2; exit 2; }"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/require-skill.mjs\""
          }
        ]
      },
      {
        "matcher": "SendMessage|mcp__room__room_post",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/require-motion-review.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/require-motion-review.mjs\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/require-motion-review.mjs\""
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "gate-ai-build": {
      "source": {
        "source": "directory",
        "path": "/Users/cponticas/Documents/GitHub/gate-ai-build"
      }
    }
  },
  "enabledPlugins": {
    "ux-designer@gate-ai-build": true
  },
  "env": {
    "UX_DESIGNER_GATE_MAIN": "1",
    "UX_DESIGNER_GATE_AGENTS": "front-end-developer",
    "UX_DESIGNER_MODE": "auto-approve"
  }
}
